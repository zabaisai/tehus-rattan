# Caddy automatically provisions and renews HTTPS certificates (Let's Encrypt)
# for the domains below the moment their DNS A records resolve to this VPS and
# ports 80/443 are reachable — no manual certbot/cron needed. HTTP is
# automatically redirected to HTTPS.
#
# Header ownership (kept non-duplicating on purpose):
#   - Caddy (this file, the TLS edge) owns Strict-Transport-Security (HSTS) —
#     the only layer that knows the request arrived over HTTPS — plus removing
#     the Server header and enforcing a request-body ceiling.
#   - The apps own their own CSP and the rest of the security headers
#     (Next.js for the frontend, Helmet for the API), so those are NOT set here.
#
# DOMINIOS (Fase 1 — TAKTO es la plataforma; ver docs/phase-1/DOMAIN-MIGRATION.md)
#   Canónicos de staging:  crm-staging.takto.online / api.crm-staging.takto.online
#   Antiguos (temporal):   crm-staging.tehusrattan.com / api.crm-staging.tehusrattan.com
#     · La API antigua se sirve como ALIAS del mismo backend (mismo bloque):
#       sin redirecciones, para no romper preflights, callbacks ni clientes
#       que todavía apunten ahí.
#     · El frontend antiguo REDIRIGE al nuevo (302: temporal y reversible;
#       pasar a `permanent` solo tras verificar el login en el dominio nuevo
#       y decidir el retiro del antiguo).
#   Producción (crm.takto.online / api.crm.takto.online) NO va aquí: ver
#   deploy/Caddyfile.production.example. Nunca apuntar producción a staging.
{
	# CHANGE this to a monitored address before the first deploy so Let's
	# Encrypt can send certificate/account expiry notices. Pendiente: buzón
	# monitorizado bajo takto.online (decisión del propietario).
	email admin@tehusrattan.com
}

# ---- Frontend (Next.js) ----------------------------------------------------
crm-staging.takto.online {
	encode zstd gzip

	# HSTS is set here (HTTPS edge) and nowhere else. No `preload` on purpose —
	# staging should not be permanently pinned in browsers' preload lists.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# The frontend accepts no large uploads (they go cross-origin to the API).
	request_body {
		max_size 2MB
	}

	reverse_proxy frontend:3000
}

# Frontend antiguo → nuevo, conservando ruta y query. Temporal (302) a
# propósito: reversible sin esperar a que caduque una caché de 301.
crm-staging.tehusrattan.com {
	header -Server
	redir https://crm-staging.takto.online{uri} temporary
}

# ---- API (NestJS) ----------------------------------------------------------
# Un solo bloque para el dominio canónico y el alias antiguo: mismo backend,
# mismos certificados, mismas cabeceras. CORS/CSRF los decide la aplicación
# por Origin (FRONTEND_URL + CSRF_ALLOWED_ORIGINS), no Caddy.
api.crm-staging.takto.online, api.crm-staging.tehusrattan.com {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# Must sit ABOVE the app's largest multipart upload (product import = 50MB,
	# logo = 2MB) so the app's own Multer limits stay the effective control and
	# Caddy only blocks absurdly large bodies.
	request_body {
		max_size 55MB
	}

	# Proxies everything, not just /api — the backend also serves uploaded files
	# under /uploads/* (see main.ts useStaticAssets), outside the /api prefix.
	# Caddy forwards X-Forwarded-For/Proto/Host so the backend's `trust proxy 1`
	# and per-IP throttler see the real client.
	reverse_proxy backend:3001
}

# ---- TAKTO · sitio comercial ------------------------------------------------
# Proyecto y contenedor SEPARADOS: repositorio takto-web, imagen takto-web,
# desplegado en /opt/takto-web. No comparte codigo, dependencias, variables,
# volumenes ni base de datos con el CRM. Caddy solo lo enruta.
#
# El destino es `takto-web:3000` y no `127.0.0.1:3100` porque Caddy corre
# dentro de un contenedor: alli 127.0.0.1 es su propio loopback, no el host.
# Se comprobo en el servidor que el contenedor NO alcanza el loopback del
# host. El contenedor de la web se une a la red `tehus-crm-staging_proxy`
# (la red de borde: caddy, frontend, backend) declarandola como externa.
# NO se une a `tehus-crm-staging_internal`, que es donde vive PostgreSQL.
takto.online {
	encode zstd gzip

	# HSTS se emite aqui, en el borde TLS, igual que en los bloques de arriba.
	# Sin `preload`: el dominio es nuevo y no debe fijarse en los navegadores.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server

	# La web comercial no recibe subidas: solo el formulario, que es JSON breve.
	request_body {
		max_size 1MB
	}

	reverse_proxy takto-web:3000
}

# El www redirige de forma permanente a la raiz, conservando ruta y query.
www.takto.online {
	redir https://takto.online{uri} permanent
}
