# Copy to /opt/tehus-crm/.env.backup and chmod 600.
# This file is intentionally separate from .env.staging because these
# credentials grant access to disaster-recovery copies, not to the CRM app.

# Preferred no-card option for staging: Google Drive through rclone.
# Configure a remote named `takto-drive` and keep its OAuth config in .secrets.
RESTIC_REPOSITORY=rclone:takto-drive:TAKTO_BACKUPS/staging
RCLONE_CONFIG=/opt/tehus-crm/.secrets/rclone.conf

# Alternative: Cloudflare R2 (or another S3-compatible service).
# Uncomment these instead of the rclone values above when using S3.
# RESTIC_REPOSITORY=s3:https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com/<R2_BUCKET>/takto-staging
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto

# The password itself lives in this root-owned/deploy-readable file, not here.
# Losing it makes every Restic snapshot unrecoverable.
RESTIC_PASSWORD_FILE=/opt/tehus-crm/.secrets/restic-password

# Stable identity and tag used for retention and restore selection.
RESTIC_HOST=tehus-crm-staging
BACKUP_RESTIC_TAG=takto-staging

# Healthchecks.io-compatible ping URLs. Configure the first check with a
# 24-hour period and a 2-hour grace time: it alerts at 26 hours without success.
BACKUP_HEARTBEAT_URL=https://hc-ping.com/<DAILY_BACKUP_CHECK_UUID>
BACKUP_DRILL_HEARTBEAT_URL=https://hc-ping.com/<MONTHLY_DRILL_CHECK_UUID>

# Existing local paths. Local copies remain a fast restore tier; Restic/R2 is
# the independent encrypted disaster-recovery tier.
BACKUP_DIR=/opt/tehus-crm/backups
COMPOSE_FILE=docker-compose.staging.yml
ENV_FILE=.env.staging
RESTORE_DRILL_DB=tehus_restore_drill
