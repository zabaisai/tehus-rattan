# Template for /opt/tehus-crm/.env.staging on the VPS.
#
# Copy this file, fill in real generated values, then:
#   chmod 600 .env.staging
# NEVER commit the filled-in file. This example intentionally has no
# placeholder values that could be mistaken for real credentials — generate
# everything with `openssl rand ...` as noted below.

# ---- PostgreSQL --------------------------------------------------------
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB are consumed directly by the
# postgres:16-alpine image AND must match the credentials embedded in
# DATABASE_URL below — keep all four in sync if you regenerate one.
POSTGRES_DB=
POSTGRES_USER=
# Recommended: openssl rand -base64 24
POSTGRES_PASSWORD=

# Host is the Docker Compose service name "postgres", never localhost —
# backend and postgres only ever talk to each other over the internal
# Docker network.
#
# TLS: on this single-host topology the connection never leaves the internal
# Docker network, so plaintext is acceptable. The MOMENT Postgres moves off-box,
# gains a replica, or is a managed provider, enable TLS on Postgres and append
# `?sslmode=require` (or `verify-full` with a CA) to the URL below. Prisma reads
# sslmode straight from the URL — no code change needed. Do NOT add sslmode while
# Postgres has no TLS configured: the connection would fail to establish.
#   Example when Postgres has TLS:
#   DATABASE_URL=postgresql://<USER>:<PASS>@<HOST>:5432/<DB>?sslmode=require
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>

# ---- Backend runtime ----------------------------------------------------
PORT=3001
NODE_ENV=production

# Required — app.module.ts refuses to boot without it.
# Recommended: openssl rand -base64 32  (>= 32 random bytes)
JWT_SECRET=

# Hashed internally with SHA-256 before use (see
# whatsapp-token-crypto.service.ts) — any long random passphrase works.
# Recommended: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Arbitrary string you also configure in the Meta/WhatsApp app webhook setup.
# Used only in the GET verify handshake. Recommended: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=

# ---- WhatsApp webhook security (see docs/WEBHOOK_SECURITY.md) -----------
# Set to "true" in staging to require Meta's X-Hub-Signature-256 on inbound
# webhook POSTs. When "true", the app refuses to boot unless both
# WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN are set.
WHATSAPP_WEBHOOK_ENABLED=true

# Meta App Secret (App Dashboard > Settings > Basic). Verifies the webhook
# HMAC signature — NOT a company access token, NOT the verify token above.
# NEVER commit the real value; keep it in the chmod 600 .env.staging only.
WHATSAPP_APP_SECRET=

# Graph API version for outbound sends (format v<major>.<minor>). REQUIRED to
# send — there is NO default in code. Set it only after verifying a currently
# supported version in your Meta account and Meta's official Graph API docs.
# Empty here on purpose; fill it in the chmod 600 .env.staging.
WHATSAPP_GRAPH_API_VERSION=

# ---- WhatsApp Embedded Signup (see docs/WHATSAPP_EMBEDDED_SIGNUP.md) -----
# Set to "true" to enable the "Conectar con Meta" flow. When "true",
# WHATSAPP_APP_ID, WHATSAPP_CONFIG_ID and WHATSAPP_APP_SECRET (above) plus a
# valid WHATSAPP_GRAPH_API_VERSION are REQUIRED (validated at boot). The 30s
# code is exchanged for a customer business token server-side using the app
# secret — NEVER expose the app secret to the browser. App id / config id are
# public and also passed to the frontend build (NEXT_PUBLIC_* below).
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_APP_ID=
WHATSAPP_CONFIG_ID=
# Single-use anti-CSRF state lifetime, minutes (default 10).
WHATSAPP_EMBEDDED_SIGNUP_STATE_TTL_MINUTES=10
# Per-IP limit for the embedded-signup endpoints (default 20).
THROTTLE_WHATSAPP_SIGNUP_LIMIT=20

# ---- Rate limiting (see docs/WEBHOOK_SECURITY.md) -----------------------
# Optional. Window (ms) + per-endpoint ceilings; unset = built-in defaults
# (staging recommendations shown). Behind Caddy (trust proxy = 1) limits are
# keyed on the real forwarded client IP.
THROTTLE_TTL=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_ONBOARDING_LIMIT=15
THROTTLE_WEBHOOK_LIMIT=600
THROTTLE_WEBHOOK_VERIFY_LIMIT=30

# Used for CORS (main.ts) AND the CookieOriginGuard allowlist on the cookie auth
# POSTs (login/refresh/logout) — must be the exact frontend origin, no trailing
# slash. See docs/AUTH_SESSION_SECURITY.md.
FRONTEND_URL=https://crm-staging.tehusrattan.com

# Optional extra allowed origins (comma-separated) for the cookie auth POSTs.
# Empty = only FRONTEND_URL is accepted. NODE_ENV=production above also makes
# the refresh cookie Secure (never sent over plain HTTP).
CSRF_ALLOWED_ORIGINS=

# DEPRECATED — no longer read by the application. Company onboarding now
# requires an individual, database-backed invitation code (see the
# InvitationCode model and InvitationCodesService), generated by a
# SUPER_ADMIN from Panel > Códigos de invitación. This variable is kept
# here only as a record of the old mechanism; it can be removed entirely
# in a future cleanup. Setting it to anything has no effect.
ONBOARDING_INVITE_CODE=

# Consumed once by `node dist/scripts/create-super-admin.js` (see
# docs/VPS_DEPLOYMENT.md) — not read by the running backend app itself.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
# Recommended: openssl rand -base64 18  (script requires >= 8 characters)
SUPER_ADMIN_PASSWORD=

# ---- Password recovery (transactional email) ----------------------------
# Set PASSWORD_RESET_ENABLED=true in staging to actually send recovery emails;
# then SMTP_HOST/SMTP_USER/SMTP_PASSWORD/SMTP_FROM_EMAIL and PASSWORD_RESET_URL
# are REQUIRED (validated at startup). Fill SMTP_* from your transactional email
# provider — never commit real credentials. The emailed link is built ONLY from
# PASSWORD_RESET_URL (no open redirect). Token TTL in minutes (default 15).
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Recommended: store the SMTP password only here, chmod 600 .env.staging
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tehus Rattan
PASSWORD_RESET_URL=https://crm-staging.tehusrattan.com/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# Per-IP throttle for forgot/reset (default 5 per THROTTLE_TTL window).
THROTTLE_PASSWORD_RESET_LIMIT=5

# ---- Frontend (build-time) ----------------------------------------------
# Inlined into the client bundle when the frontend image is built (see
# apps/frontend/src/lib/axios.ts) — must be passed as a build ARG, not just
# a runtime variable. deploy.sh reads it from this same file via
# `docker compose --env-file .env.staging ...` so the compose file's
# `args: NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL}` resolves correctly.
NEXT_PUBLIC_API_URL=https://api.crm-staging.tehusrattan.com/api
# Public Meta App ID and Embedded Signup configuration id, inlined into the
# client bundle so the browser can launch the Meta JS SDK. These are PUBLIC
# values (never the app secret). Must match WHATSAPP_APP_ID / WHATSAPP_CONFIG_ID
# above and be passed as build ARGs (see docker-compose.staging.yml frontend
# build args). Leave empty to build without the "Conectar con Meta" button.
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# ─────────────────────────────────────────────────────────────
# COLA DURABLE (Redis + BullMQ)
# ─────────────────────────────────────────────────────────────
# Redis NO es fuente de verdad: el estado durable vive en PostgreSQL. Redis
# solo transporta trabajos (esperas, reintentos, automatizaciones diferidas,
# descarga de medios). Perderlo degrada el procesamiento asincrono, nunca los
# datos comerciales.
#
# En staging Redis vive solo en la red `internal` de Docker, SIN puertos
# publicados, igual que PostgreSQL. Por eso REDIS_PASSWORD queda vacia: un
# secreto que nunca sale de una red privada da falsa sensacion de seguridad.
# Si algun dia Redis se expone, pasa a ser obligatoria.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
