# EJEMPLO para producción (crm.takto.online / api.crm.takto.online).
#
# NO es un archivo de staging y NO se usa en esta fase. Producción tendrá su
# propio stack, base de datos, secretos, remote de respaldo y latidos. Los
# valores de abajo solo fijan los DOMINIOS y el remitente de la plataforma;
# el resto se genera igual que en deploy/env/staging.env.example (leer sus
# comentarios: son la referencia de cada variable). Nunca reutilizar secretos
# de staging ni apuntar estos dominios al servidor de staging.

NODE_ENV=production
PORT=3001

# Origen EXACTO del frontend de producción (CORS + CSRF). Sin barra final.
FRONTEND_URL=https://crm.takto.online
# Sin orígenes extra en producción salvo justificación escrita. Nunca "*".
CSRF_ALLOWED_ORIGINS=

# Remitente general de la plataforma (una empresa cliente nunca es remitente
# general).
SMTP_FROM_NAME=TAKTO
PASSWORD_RESET_URL=https://crm.takto.online/reset-password

# Inlined into the frontend bundle at build time (build ARG).
NEXT_PUBLIC_API_URL=https://api.crm.takto.online/api

# Todo lo demás (PostgreSQL, JWT_SECRET, WhatsApp, throttling, SMTP, Redis):
# ver deploy/env/staging.env.example y generar valores propios de producción.
