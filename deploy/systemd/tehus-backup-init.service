[Unit]
Description=Initialize TAKTO encrypted off-site repository once
Documentation=file:/opt/tehus-crm/docs/OFFSITE_BACKUPS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/tehus-crm
EnvironmentFile=/opt/tehus-crm/.env.backup
UMask=0077
ExecStart=/opt/tehus-crm/deploy/scripts/backup-restic-init.sh
RemainAfterExit=yes
