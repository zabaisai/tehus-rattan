DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tehus_rattan"
PORT=3001
NODE_ENV=development
JWT_SECRET="example_fictitious_jwt_secret_change_me"
WHATSAPP_TOKEN_ENCRYPTION_KEY="change-me"

# ---- Auth / CSRF (see docs/AUTH_SESSION_SECURITY.md) --------------------
# Frontend origin, used for CORS and the CookieOriginGuard allowlist on the
# cookie auth POSTs (login/refresh/logout). No trailing slash.
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins (comma-separated) for those cookie endpoints.
# Leave empty to allow only FRONTEND_URL (+ localhost:3000 in non-production).
CSRF_ALLOWED_ORIGINS=

# ---- WhatsApp webhook security (see docs/WEBHOOK_SECURITY.md) -----------
# Set to "true" to require Meta's X-Hub-Signature-256 on inbound webhook POSTs.
# When "true", WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN become mandatory
# and the app refuses to boot without them. The signature guard is fail-closed
# regardless: with no app secret, POST /api/webhook is rejected (503), never
# processed.
WHATSAPP_WEBHOOK_ENABLED=false
# Meta App Secret (App Dashboard > Settings > Basic). Used ONLY to verify
# X-Hub-Signature-256 — NOT the per-company access token, NOT the verify token.
WHATSAPP_APP_SECRET=
# Arbitrary string you also set in the Meta webhook config (GET handshake).
WHATSAPP_VERIFY_TOKEN=
# Graph API version for outbound sends (format v<major>.<minor>). REQUIRED to
# send: there is NO default in code. Set it only after verifying a currently
# supported version in your Meta account and Meta's official Graph API docs.
# If left empty, outbound sends fail with a controlled config error (no Meta
# call is made); inbound webhooks are unaffected.
WHATSAPP_GRAPH_API_VERSION=

# ---- WhatsApp Embedded Signup (see docs/WHATSAPP_EMBEDDED_SIGNUP.md) -----
# Opt-in. When "true", the "Conectar con Meta" flow is enabled and the
# server-side code exchange requires WHATSAPP_APP_ID, WHATSAPP_CONFIG_ID and
# WHATSAPP_APP_SECRET (+ a valid WHATSAPP_GRAPH_API_VERSION) — all validated at
# boot. When unset/false (default in dev/tests) the embedded-signup endpoints
# return a controlled 503 and the legacy manual connection remains available.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
# Meta App ID (App Dashboard > Settings > Basic). Public value; also exposed to
# the browser as NEXT_PUBLIC_WHATSAPP_APP_ID for the Meta JS SDK.
WHATSAPP_APP_ID=
# Embedded Signup configuration id (App Dashboard > WhatsApp > Embedded Signup).
# Public value; also exposed as NEXT_PUBLIC_WHATSAPP_CONFIG_ID.
WHATSAPP_CONFIG_ID=
# The 30s exchangeable code is swapped for a customer business token using
# WHATSAPP_APP_SECRET as the client_secret — reuses the same secret as the
# webhook HMAC above. NEVER expose the app secret to the browser.
# Single-use anti-CSRF state lifetime, minutes (default 10).
WHATSAPP_EMBEDDED_SIGNUP_STATE_TTL_MINUTES=10

# ---- Rate limiting (see docs/WEBHOOK_SECURITY.md) -----------------------
# Window in milliseconds and per-endpoint request ceilings. All optional —
# these are the built-in defaults; override only to tune for your environment.
THROTTLE_TTL=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_ONBOARDING_LIMIT=15
THROTTLE_WEBHOOK_LIMIT=600
THROTTLE_WEBHOOK_VERIFY_LIMIT=30
# Per-IP limit for the forgot/reset-password endpoints.
THROTTLE_PASSWORD_RESET_LIMIT=5
# Per-IP limit for the Meta Embedded Signup start/complete/reconnect endpoints.
THROTTLE_WHATSAPP_SIGNUP_LIMIT=20

# ---- Password recovery (transactional email) ----------------------------
# Opt-in. When PASSWORD_RESET_ENABLED=true the SMTP_* values below AND
# PASSWORD_RESET_URL are required (validated at startup) and recovery emails are
# actually sent. When unset/false (the default in dev/tests) the recovery
# endpoints still work, but sending is a controlled no-op — the token is never
# printed; read it from the DB for local testing. No real secrets here.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tehus Rattan
# Absolute URL of the frontend reset page — the emailed link is built ONLY from
# this value (no open redirect). Token lifetime in minutes (default 15).
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# ---- FlowBot: envío real de WhatsApp (docs/FLOWBOT-ACTIVACION-WHATSAPP.md) --
#
# TODO APAGADO. Estos son los valores por defecto, los mismos que aplica el
# código cuando las variables no existen: copiarlos tal cual no cambia nada,
# que es lo que se quiere mientras no haya autorización para encenderlo.
#
# La ausencia de configuración equivale a BLOQUEADO: las listas vacías
# significan «ninguno», nunca «todos». Y las banderas solo cambian con el texto
# exacto, así que `1`, `yes` o `TRUE_` dejan el seguro puesto.
#
# Ningún valor de aquí es real.

# Permite llegar a dry-run o a real.
FLOWBOT_REAL_WHATSAPP_ENABLED=false
# Mientras esté puesta se prepara el envío entero y NO sale nada.
FLOWBOT_WHATSAPP_DRY_RUN=true
# Ids de empresa separados por coma. Vacía = ninguna empresa puede enviar.
FLOWBOT_WHATSAPP_COMPANY_ALLOWLIST=
# phoneNumberId de los remitentes permitidos. Vacía = ningún número.
FLOWBOT_WHATSAPP_PHONE_ALLOWLIST=
# Destinatarios de prueba. Se comparan por dígitos: da igual el formato.
FLOWBOT_WHATSAPP_RECIPIENT_ALLOWLIST=
# Idioma con el que se piden las plantillas. Debe coincidir con el aprobado.
WHATSAPP_TEMPLATE_LANGUAGE=es
# SOLO PRUEBAS LOCALES. Admite unicamente localhost/127.0.0.1; con cualquier
# otro destino se ignora y se usa Meta. En produccion, sin poner.
# WHATSAPP_GRAPH_BASE_URL=
