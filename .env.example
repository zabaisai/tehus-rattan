DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tehus_rattan"
PORT=3001
NODE_ENV=development
JWT_SECRET="example_fictitious_jwt_secret_change_me"
WHATSAPP_TOKEN_ENCRYPTION_KEY="change-me"

# ---- WhatsApp webhook security (see docs/WEBHOOK_SECURITY.md) -----------
# Set to "true" to require Meta's X-Hub-Signature-256 on inbound webhook POSTs.
# When "true", WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN become mandatory
# and the app refuses to boot without them. The signature guard is fail-closed
# regardless: with no app secret, POST /api/webhook is rejected (503), never
# processed.
WHATSAPP_WEBHOOK_ENABLED=false
# Meta App Secret (App Dashboard > Settings > Basic). Used ONLY to verify
# X-Hub-Signature-256 — NOT the per-company access token, NOT the verify token.
WHATSAPP_APP_SECRET=
# Arbitrary string you also set in the Meta webhook config (GET handshake).
WHATSAPP_VERIFY_TOKEN=
# Graph API version for outbound sends (format v<major>.<minor>). Defaults to
# v19.0 when unset. Bump to the version you have verified against Meta.
WHATSAPP_GRAPH_API_VERSION=v19.0

# ---- Rate limiting (see docs/WEBHOOK_SECURITY.md) -----------------------
# Window in milliseconds and per-endpoint request ceilings. All optional —
# these are the built-in defaults; override only to tune for your environment.
THROTTLE_TTL=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_ONBOARDING_LIMIT=15
THROTTLE_WEBHOOK_LIMIT=600
THROTTLE_WEBHOOK_VERIFY_LIMIT=30
