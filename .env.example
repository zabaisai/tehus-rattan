DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tehus_rattan"
PORT=3001
NODE_ENV=development
JWT_SECRET="example_fictitious_jwt_secret_change_me"
WHATSAPP_TOKEN_ENCRYPTION_KEY="change-me"

# ---- Auth / CSRF (see docs/AUTH_SESSION_SECURITY.md) --------------------
# Frontend origin, used for CORS and the CookieOriginGuard allowlist on the
# cookie auth POSTs (login/refresh/logout). No trailing slash.
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins (comma-separated) for those cookie endpoints.
# Leave empty to allow only FRONTEND_URL (+ localhost:3000 in non-production).
CSRF_ALLOWED_ORIGINS=

# ---- WhatsApp webhook security (see docs/WEBHOOK_SECURITY.md) -----------
# Set to "true" to require Meta's X-Hub-Signature-256 on inbound webhook POSTs.
# When "true", WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN become mandatory
# and the app refuses to boot without them. The signature guard is fail-closed
# regardless: with no app secret, POST /api/webhook is rejected (503), never
# processed.
WHATSAPP_WEBHOOK_ENABLED=false
# Meta App Secret (App Dashboard > Settings > Basic). Used ONLY to verify
# X-Hub-Signature-256 — NOT the per-company access token, NOT the verify token.
WHATSAPP_APP_SECRET=
# Arbitrary string you also set in the Meta webhook config (GET handshake).
WHATSAPP_VERIFY_TOKEN=
# Graph API version for outbound sends (format v<major>.<minor>). REQUIRED to
# send: there is NO default in code. Set it only after verifying a currently
# supported version in your Meta account and Meta's official Graph API docs.
# If left empty, outbound sends fail with a controlled config error (no Meta
# call is made); inbound webhooks are unaffected.
WHATSAPP_GRAPH_API_VERSION=

# ---- Rate limiting (see docs/WEBHOOK_SECURITY.md) -----------------------
# Window in milliseconds and per-endpoint request ceilings. All optional —
# these are the built-in defaults; override only to tune for your environment.
THROTTLE_TTL=60000
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
THROTTLE_REFRESH_LIMIT=30
THROTTLE_ONBOARDING_LIMIT=15
THROTTLE_WEBHOOK_LIMIT=600
THROTTLE_WEBHOOK_VERIFY_LIMIT=30
# Per-IP limit for the forgot/reset-password endpoints.
THROTTLE_PASSWORD_RESET_LIMIT=5

# ---- Password recovery (transactional email) ----------------------------
# Opt-in. When PASSWORD_RESET_ENABLED=true the SMTP_* values below AND
# PASSWORD_RESET_URL are required (validated at startup) and recovery emails are
# actually sent. When unset/false (the default in dev/tests) the recovery
# endpoints still work, but sending is a controlled no-op — the token is never
# printed; read it from the DB for local testing. No real secrets here.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tehus Rattan
# Absolute URL of the frontend reset page — the emailed link is built ONLY from
# this value (no open redirect). Token lifetime in minutes (default 15).
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
