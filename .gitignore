# Local scratchpad / reference files
scratchpad/

# Env files — real values must never be committed anywhere in the tree.
# Only the *.example templates (fictitious values) are tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!deploy/env/staging.env.example

# Private keys / certificates
*.pem
*.p12
*.pfx

# Deployment secrets — real values only ever exist on the VPS or in a local
# throwaway file while testing docker-compose.staging.yml, never committed.
.env.staging
.env.staging.*
/.env.backup
/.secrets/

# PostgreSQL dumps produced by deploy/scripts/backup-postgres.sh on the VPS.
/backups/

# El paquete de marca NO se versiona aqui.
#
# Entro por error en d3bc633 con un `git add -A` y son 208 archivos y 4,4 MB
# que no pertenecen al repositorio del producto. Esta linea evita que vuelva a
# colarse en el proximo `add -A`.
brand/
