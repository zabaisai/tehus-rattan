generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String        @id @default(cuid())
  name      String
  phone     String?       @unique
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Informational company profile — display-only, never legal/fiscal/billing data.
  slug             String? @unique
  logoUrl          String?
  secondaryLogoUrl String?
  primaryColor     String?
  accentColor      String?
  backgroundColor  String?
  businessType     String?
  city             String?
  country          String?
  email            String?
  website          String?
  description      String?
  settings         Json?

  // Per-company fiscal identity used to render quotes/printable documents.
  // All optional and additive — an empty field is simply omitted from the
  // printed document, never replaced by a global/hardcoded fallback.
  legalName   String? // Razón social
  taxId       String? // Identificación fiscal / NIT
  address     String? // Dirección
  quoteFooter String? // Texto/condiciones opcionales para el pie de cotizaciones

  // Configuración regional. Con default para que toda empresa existente y
  // futura tenga un valor válido sin backfill manual: hasta ahora las fechas
  // se renderizaban en la zona del navegador y los montos sin moneda
  // explícita, lo que es ambiguo en cuanto entra una segunda empresa.
  // `businessHours` queda nullable a propósito: "sin horario definido" es un
  // estado distinto de "horario vacío", y las reglas de asignación deben
  // poder distinguirlos.
  timezone      String @default("America/Bogota")
  currency      String @default("COP")
  locale        String @default("es-CO")
  businessHours Json?

  // Asignación automática de conversaciones y oportunidades entrantes.
  // Activada por defecto: una empresa que estrena el CRM prefiere que el
  // mensaje llegue a alguien antes que quedarse esperando a que un
  // administrador descubra que hay una bandeja sin asignar. Se puede apagar y
  // entonces todo entra sin asesor, a la bandeja común.
  autoAssignEnabled Boolean @default(true)

  /// Minutos que puede pasar un mensaje entrante sin respuesta antes de
  /// considerarse incumplido. `null` = sin compromiso definido, que es lo
  /// contrario de "cero minutos": una empresa sin SLA no debe recibir alarmas
  /// por cada conversacion.
  responseSlaMinutes Int?

  /// Meses que se conservan conversaciones y mensajes cerrados antes de
  /// poder purgarlos. `null` = SIN PURGA, que es el valor por defecto a
  /// proposito (decision 13): borrar el historial comercial de una empresa
  /// sin que lo haya pedido es irreversible, y "por defecto no se borra nada"
  /// es la unica postura defendible.
  retentionMonths Int?

  /// Confirmacion explicita de que la empresa acepta la purga. Sin esto, un
  /// `retentionMonths` puesto por error empezaria a borrar solo.
  retentionPurgeEnabled Boolean @default(false)

  dataRequests DataRequest[]

  users                User[]
  contacts             Contact[]
  conversations        Conversation[]
  automations          Automation[]
  pipelines            Pipeline[]
  leads                Lead[]
  tasks                Task[]
  notes                Note[]
  products             Product[]
  quotes               Quote[]
  whatsappIntegrations WhatsAppIntegration[]
  whatsappSignupStates WhatsAppEmbeddedSignupState[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  auditLogs            AuditLog[]                    @relation("AuditLogAffectedCompany")
  supportSessions      SupportSession[]
  automationRuns       AutomationRun[]
  chatbotFlows         ChatbotFlow[]
  chatbotSessions      ChatbotSession[]
  invitationCodesUsed  InvitationCode[]
  userSessions         UserSession[]
  loginEvents          LoginEvent[]
  outboxEvents         OutboxEvent[]
  flowBots             FlowBot[]
  flowBotExecutions    FlowBotExecution[]
  flowBotWaits         FlowBotWait[]
  flowBotMetrics       FlowBotMetric[]
  flowBotTestRuns      FlowBotTestRun[]
  leadSettings         CompanyLeadSettings?

  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  customFieldChanges     CustomFieldValueChange[]

  handoffs ConversationHandoff[]

  flowBotCredentials FlowBotCredential[]
  flowBotSettings    FlowBotSettings?
  flowBotAiUsage     FlowBotAiUsage[]

  @@map("companies")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(AGENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Reparto automático ──────────────────────────────────────
  // Quién entra en el turno. Separado de `isActive` porque son cosas
  // distintas: un supervisor puede estar perfectamente activo y aun así no
  // querer recibir conversaciones nuevas. Desactivarlo NO le quita las que ya
  // tiene, solo lo saca del reparto.
  autoAssignEnabled Boolean @default(true)

  // Última vez que este usuario recibió algo por reparto automático. Es lo
  // que hace el round-robin: siempre le toca a quien lleva más tiempo sin
  // recibir. Guardarlo en la fila (en vez de un contador en memoria) hace que
  // el turno sobreviva a reinicios y funcione con varios procesos, que es
  // justo donde un round-robin ingenuo se rompe y empieza a repetir persona.
  lastAssignedAt DateTime?

  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id])
  conversations   Conversation[]
  leads           Lead[]
  stageChanges    LeadStageHistory[]
  tasks           Task[]
  notes           Note[]
  quotes          Quote[]
  auditLogs       AuditLog[]         @relation("AuditLogActor")
  supportSessions SupportSession[]

  invitationCodesCreated InvitationCode[] @relation("InvitationCodeCreatedBy")
  invitationCodesUsed    InvitationCode[] @relation("InvitationCodeUsedBy")
  invitationCodesRevoked InvitationCode[] @relation("InvitationCodeRevokedBy")

  sessions            UserSession[]        @relation("UserSessionUser")
  sessionsRevoked     UserSession[]        @relation("UserSessionRevokedBy")
  loginEvents         LoginEvent[]
  passwordResetTokens PasswordResetToken[]

  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsAuthored   Notification[]           @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  conversationReads       ConversationRead[]

  // FlowBot: quien crea, edita, publica y prueba los bots.
  flowBotsCreated          FlowBot[]        @relation("FlowBotCreatedBy")
  flowBotsUpdated          FlowBot[]        @relation("FlowBotUpdatedBy")
  flowBotVersionsPublished FlowBotVersion[] @relation("FlowBotVersionPublishedBy")
  flowBotTestRuns          FlowBotTestRun[] @relation("FlowBotTestRunCreatedBy")

  // Elegir a quién le toca es una consulta caliente: ocurre en cada mensaje
  // entrante de un contacto nuevo. Con este índice sale directa, sin recorrer
  // los usuarios de la empresa.
  leadSettingsAssigned CompanyLeadSettings[] @relation("LeadSettingsUser")

  @@index([companyId, isActive, autoAssignEnabled, lastAssignedAt])
  customFieldChanges CustomFieldValueChange[] @relation("CustomFieldChangeActor")

  handoffsAssigned ConversationHandoff[] @relation("HandoffAssignee")
  handoffsResolved ConversationHandoff[] @relation("HandoffResolver")

  @@map("users")
}

model Contact {
  id        String   @id @default(cuid())
  phone     String
  name      String?
  email     String?
  tags      String[]
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  /// Archivado SEGURO: se marca, nunca se borra.
  ///
  /// Un contacto archivado conserva sus conversaciones, sus oportunidades y
  /// su historial: son datos del negocio y de la persona. Lo que cambia es
  /// que deja de aparecer en las listas de trabajo y que los bots no arrancan
  /// solos con el. Si vuelve a escribir, `CompanyLeadSettings.reactivateArchived`
  /// decide si se reactiva o si se registra sin reabrir.
  ///
  /// Distinto de `isBlocked`, que significa "no queremos hablar con esta
  /// persona". Archivar es "ya no esta activo"; bloquear es una decision
  /// sobre la relacion.
  archivedAt     DateTime?
  archivedReason String?

  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  conversations Conversation[]
  leads         Lead[]
  tasks         Task[]

  flowBotExecutions FlowBotExecution[]

  customFieldValues CustomFieldValue[]

  @@unique([phone, companyId])
  @@map("contacts")
}

model Conversation {
  id            String             @id @default(cuid())
  status        ConversationStatus @default(OPEN)
  stage         String?
  isPaused      Boolean            @default(false)
  channel       String             @default("whatsapp")
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  contactId  String
  contact    Contact @relation(fields: [contactId], references: [id])
  assignedTo String?
  agent      User?   @relation(fields: [assignedTo], references: [id])

  // Oportunidad comercial que originó esta conversación. Nullable a
  // propósito y para siempre: no toda conversación es una venta (soporte,
  // consultas, spam), y forzarla obligaría a inventar oportunidades vacías.
  // Es el vínculo que hoy falta y que deja 4 de 4 conversaciones fuera del
  // pipeline. `SetNull` al borrar el lead: la conversación y sus mensajes son
  // el registro de lo que ocurrió y no deben desaparecer con la oportunidad.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Numero de la empresa por el que ENTRO esta conversacion.
  //
  // Sin esto, una empresa con dos numeros contesta siempre desde el
  // principal: quien escribio a "Soporte" recibe la respuesta desde
  // "Ventas", un numero que no reconoce y al que no habia escrito.
  //
  // Nullable porque las conversaciones anteriores a este campo no pueden
  // saberlo, y porque un CSV importado no tiene numero de entrada. En ambos
  // casos el envio cae en el principal, que es el comportamiento de siempre.
  whatsappIntegrationId String?
  whatsappIntegration   WhatsAppIntegration? @relation(fields: [whatsappIntegrationId], references: [id], onDelete: SetNull)

  messages        Message[]
  notes           Note[]
  tasks           Task[]
  reads           ConversationRead[]
  chatbotSessions ChatbotSession[]

  flowBotExecutions FlowBotExecution[]

  handoffs ConversationHandoff[]

  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedTo])
  @@index([leadId])
  @@map("conversations")
}

model Message {
  id        String      @id @default(cuid())
  wamid     String?     @unique
  body      String?
  type      MessageType @default(TEXT)
  direction Direction

  /// De donde salio este mensaje.
  ///
  /// EXISTE PARA QUE EL HISTORIAL IMPORTADO NO DISPARE NADA. Un mensaje de
  /// hace seis meses no debe crear una oportunidad, ni ejecutar
  /// automatizaciones, ni despertar al chatbot: eso mandaria cientos de
  /// WhatsApp a clientes por conversaciones que ya terminaron. Sin este campo
  /// no hay forma de distinguirlo de un mensaje que acaba de llegar.
  source    MessageSource @default(LIVE)
  status    MessageStatus @default(QUEUED)
  createdAt DateTime      @default(now())

  // ── Medios ──────────────────────────────────────────────────
  // El binario NO se guarda aquí. `mediaId` es el identificador de Meta, que
  // caduca; `mediaUrl` apunta al archivo ya descargado y servido por el CRM
  // tras autenticar. Separarlos permite reintentar la descarga sin perder la
  // referencia original y detectar los medios que aún no se han traído.
  mediaId       String?
  mediaUrl      String?
  mediaMimeType String?
  mediaFileName String?
  mediaSize     Int?
  mediaDuration Int? // segundos, para audio y video
  caption       String?

  // Ubicación y contacto compartido. JSON porque su forma la define Meta y
  // normalizarla en columnas obligaría a migrar cada vez que cambie.
  location Json?
  contacts Json?

  // Mensaje al que responde este, tal como lo entrega Meta (context.id). Se
  // guarda el wamid y no una FK: la respuesta puede referirse a un mensaje
  // anterior a la conexión, que el CRM nunca llegó a almacenar.
  replyToWamid String?

  // Payload de interactivos (botones y listas) ya sanitizado.
  interactive Json?

  // ── Estados de entrega ──────────────────────────────────────
  // Hoy el estado nunca pasa de SENT porque los payloads `statuses` de Meta
  // se descartan. Estas marcas permiten reflejar el ciclo real y detectar
  // envíos fallidos sin releer el log.
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  // Clasificador de error ya redactado; NUNCA la respuesta cruda de Meta,
  // que puede incluir el token o datos del destinatario.
  errorCode    String?
  errorMessage String?

  /// Clave de idempotencia de un mensaje SALIENTE que genera el sistema.
  ///
  /// EXISTE PORQUE `wamid` NO SIRVE PARA ESTO: lo asigna Meta y solo se
  /// conoce DESPUES de enviar, asi que no puede impedir el envio duplicado
  /// que ocurre justo antes. Aqui se guarda la clave del motor
  /// —`ejecucion:nodo:paso`— y se reserva la fila ANTES de llamar a Meta: un
  /// reintento la reencuentra y no reenvia.
  ///
  /// Nula para los mensajes entrantes y para los que escribe un asesor a
  /// mano, que no tienen de que ser idempotentes.
  externalKey String? @unique

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@index([conversationId, status])
  @@index([status, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────
// AUTOMATIZACION
// ─────────────────────────────────────────────
model Automation {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  trigger    String
  conditions Json?
  actions    Json
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// Version actual de la definicion. Sube en cada cambio de disparador,
  /// condiciones o acciones. Permite responder a "esto se ejecuto asi porque
  /// la automatizacion decia otra cosa entonces", que sin versionar es
  /// imposible de reconstruir.
  version Int @default(1)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  versions AutomationVersion[]
  runs     AutomationRun[]

  @@map("automations")
}

/// Foto de la definicion en el momento de publicarse.
///
/// Sin esto, el historial de ejecuciones seria enganoso: se veria QUE paso
/// pero no la regla que lo provoco, porque la automatizacion pudo cambiar
/// despues. Es tambien lo que permite revertir a una version anterior sin
/// reconstruirla de memoria.
model AutomationVersion {
  id      String @id @default(cuid())
  version Int

  trigger    String
  conditions Json?
  actions    Json

  /// Quien la publico. Nullable porque una automatizacion puede nacer de una
  /// plantilla o de una migracion, sin autor humano.
  createdBy String?
  createdAt DateTime @default(now())

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, version])
  @@map("automation_versions")
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  /// Agotados los reintentos. Queda para inspeccion y reejecucion manual: es
  /// el equivalente a una dead-letter queue, en la base y no en Redis, para
  /// que sobreviva a un reinicio de Redis.
  DEAD
}

/// Una ejecucion de una automatizacion.
///
/// EXISTE PORQUE HOY NO HAY NINGUN RASTRO. El motor actual ejecuta en linea y
/// se traga los errores en un `logger.error`: si una automatizacion deja de
/// funcionar, nadie se entera, y cuando alguien pregunta "¿por que no se
/// mando ese mensaje?" no hay nada que mirar.
model AutomationRun {
  id String @id @default(cuid())

  /// Version de la definicion que se ejecuto. Con la automatizacion ya
  /// modificada, es lo unico que explica el resultado.
  automationVersion Int

  status   AutomationRunStatus @default(PENDING)
  attempts Int                 @default(0)

  /// Que disparo la ejecucion y sobre que. Sin PII: ids, nunca el texto del
  /// mensaje ni el telefono.
  triggerType String

  /// Resultado de cada accion, en orden. Permite ver donde se rompio una
  /// ejecucion a medias, que es justo lo que un log plano no deja reconstruir.
  steps Json?

  /// Clasificador del error, nunca el mensaje crudo del proveedor.
  lastError String?

  /// Misma llave que el outbox: garantiza que un reintento del mensaje no
  /// vuelva a ejecutar las acciones.
  idempotencyKey String @unique

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversationId String?

  @@index([companyId, createdAt])
  @@index([automationId, createdAt])
  @@index([status, createdAt])
  @@map("automation_runs")
}

// ─────────────────────────────────────────────
// CRM CORE: PIPELINE Y LEADS
// ─────────────────────────────────────────────
model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Orden de presentación en el selector. Separado de `createdAt` para que
  // reordenar no dependa de cuándo se creó cada pipeline.
  order Int @default(0)

  // Archivar en lugar de borrar: un pipeline con leads no se puede eliminar
  // (RESTRICT en la FK), así que archivar es la única forma de retirarlo de
  // la vista sin perder su historial comercial.
  isArchived Boolean @default(false)

  companyId String
  company   Company         @relation(fields: [companyId], references: [id])
  stages    PipelineStage[]
  leads     Lead[]

  // La unicidad del predeterminado por empresa NO se puede expresar aquí:
  // Prisma no soporta índices parciales. Se crea como SQL en la migración
  // (`pipelines_one_default_per_company`) y se refuerza en el servicio dentro
  // de una transacción. Ver la nota en el propio migration.sql.
  leadSettingsUsing CompanyLeadSettings[] @relation("LeadSettingsPipeline")

  @@index([companyId, isArchived, order])
  @@map("pipelines")
}

model PipelineStage {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  /// Etapa por la que ENTRAN las oportunidades automaticas.
  ///
  /// Antes se usaba "la primera por orden", que funciona hasta que alguien
  /// reordena el tablero y las oportunidades nuevas empiezan a caer en otra
  /// etapa sin que nadie lo haya pedido. Marcarla explicitamente separa "donde
  /// esta dibujada" de "por donde se entra".
  ///
  /// El nombre puede ser "Nuevo lead" o cualquier otro: el comportamiento se
  /// ata a esta bandera, nunca al texto.
  isInitial Boolean  @default(false)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Probabilidad de cierre en porcentaje (0-100). Nullable a propósito: "sin
  // definir" no es lo mismo que 0%, y el pronóstico ponderado debe poder
  // ignorar las etapas que aún no la tienen en vez de contarlas como perdidas.
  probability Int?

  // Semántica comercial de la etapa. Hoy el cierre vive en `Lead.status`;
  // este campo permite que el pipeline declare qué etapa SIGNIFICA ganado o
  // perdido, que es lo que necesitan las automatizaciones por cambio de etapa
  // y las métricas de conversión. Se introduce como aditivo: `Lead.status`
  // sigue siendo la fuente de verdad hasta que la transición se complete.
  type StageType @default(OPEN)

  pipelineId        String
  pipeline          Pipeline              @relation(fields: [pipelineId], references: [id])
  leads             Lead[]
  leadSettingsUsing CompanyLeadSettings[] @relation("LeadSettingsStage")

  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

enum StageType {
  OPEN
  WON
  LOST
}

model Lead {
  id                String     @id @default(cuid())
  title             String
  value             Float?     @default(0)
  status            LeadStatus @default(OPEN)
  lostReason        String?
  expectedCloseDate DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])

  assignedTo String?
  agent      User?   @relation(fields: [assignedTo], references: [id])

  stageHistory  LeadStageHistory[]
  tasks         Task[]
  conversations Conversation[]
  notes         Note[]
  leadProducts  LeadProduct[]
  quotes        Quote[]

  flowBotExecutions FlowBotExecution[]

  customFieldValues CustomFieldValue[]

  @@index([companyId, status])
  @@index([pipelineId, stageId])
  @@index([contactId])
  @@map("leads")
}

model LeadProduct {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  // Snapshot of Product.price at the moment it was attached — must not
  // follow future catalog price changes, since quotes built from this later
  // need to reflect the price the lead actually saw.
  unitPrice Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([leadId, productId])
  @@map("lead_products")
}

model LeadStageHistory {
  id          String   @id @default(cuid())
  fromStageId String?
  toStageId   String
  changedAt   DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  changedBy String?
  user      User?   @relation(fields: [changedBy], references: [id])

  @@map("lead_stage_histories")
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

// ─────────────────────────────────────────────
// TAREAS Y NOTAS
// ─────────────────────────────────────────────
model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(TASK)
  status      TaskStatus   @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // Conversación de origen. Permite crear una tarea desde el chat sin salir
  // de él y mostrar en la conversación las tareas que genera. `SetNull` para
  // que archivar o borrar una conversación no borre el seguimiento.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  assignedTo String?
  agent      User?   @relation(fields: [assignedTo], references: [id])

  @@index([companyId, status, dueDate])
  @@index([companyId, assignedTo])
  @@index([conversationId])
  @@map("tasks")
}

model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  createdBy String?
  user      User?   @relation(fields: [createdBy], references: [id])

  @@map("notes")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  FOLLOW_UP
  CALL
  MEETING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// PRODUCTOS
// ─────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  code        String?
  name        String
  description String?
  price       Float
  imageUrl    String?
  category    String?
  sku         String?
  stock       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadProducts LeadProduct[]
  quoteItems   QuoteItem[]

  @@map("products")
}

// ─────────────────────────────────────────────
// COTIZACIONES
// ─────────────────────────────────────────────
model Quote {
  id         String      @id @default(cuid())
  number     String
  title      String?
  status     QuoteStatus @default(DRAFT)
  // subtotal/total are computed and stored by the backend on every write —
  // never trust a client-supplied value for either.
  subtotal   Float       @default(0)
  discount   Float       @default(0)
  total      Float       @default(0)
  notes      String?
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  items QuoteItem[]

  // number is only unique per company, not globally, since each company
  // has its own COT-0001, COT-0002... sequence.
  @@unique([companyId, number])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteItem {
  id          String   @id @default(cuid())
  // Full snapshot of the LeadProduct/Product at the moment the quote was
  // created — name/description/category/unitPrice never follow later
  // catalog edits, so a sent quote always reflects what the client saw.
  name        String
  description String?
  category    String?
  quantity    Int
  unitPrice   Float
  subtotal    Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

// ─────────────────────────────────────────────
// WHATSAPP INTEGRATION
// ─────────────────────────────────────────────
model WhatsAppIntegration {
  id                   String                    @id @default(cuid())
  displayPhoneNumber   String?
  phoneNumberId        String                    @unique
  wabaId               String?
  businessId           String?
  businessName         String?
  status               WhatsAppIntegrationStatus @default(PENDING)
  connectionMethod     WhatsAppConnectionMethod  @default(MANUAL)
  accessTokenEncrypted String?
  connectedAt          DateTime?
  disconnectedAt       DateTime?
  lastCheckedAt        DateTime?
  // Redacted error classifier for the last failed attempt (never a secret /
  // never a raw Meta payload). Cleared on a successful (re)connection.
  lastErrorCode        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  // Numero principal de la empresa. Es el que se usa para enviar cuando el
  // llamador no indica cual, de modo que `findFirst` deje de devolver una fila
  // arbitraria en cuanto haya varios numeros.
  isPrimary Boolean @default(false)

  // Nombre interno para que el asesor no tenga que reconocer un phoneNumberId
  // de 16 digitos en la interfaz ("Ventas", "Soporte", "Numero de prueba").
  label String?

  // Orden de presentacion en los selectores.
  order Int @default(0)

  // `companyId` YA NO es unico: una empresa puede conectar varios numeros.
  // Lo que sigue garantizado en base:
  //   - `phoneNumberId` unico GLOBAL: un numero pertenece a una sola empresa,
  //     que es lo que hace inequivoco el enrutamiento del webhook.
  //   - `whatsapp_one_primary_per_company` (indice parcial en el SQL de la
  //     migracion): una sola integracion principal por empresa.
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  conversations Conversation[]

  // FlowBot: disparadores atados a este numero y ejecuciones que entraron por el.
  flowBotTriggers   FlowBotTrigger[]
  flowBotExecutions FlowBotExecution[]

  @@index([companyId, isPrimary])
  @@map("whatsapp_integrations")
}

// Short-lived, single-use anti-CSRF state for the Meta Embedded Signup flow.
// Mirrors the PasswordResetToken security model: only the SHA-256 hash of the
// opaque state is stored; the plaintext lives only in the browser during the
// flow and is never persisted, logged, or returned by the API.
model WhatsAppEmbeddedSignupState {
  id                 String    @id @default(cuid())
  companyId          String
  stateHash          String    @unique
  usedAt             DateTime?
  expiresAt          DateTime
  createdByUserId    String?
  requestedIpPreview String?
  createdAt          DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
  @@map("whatsapp_embedded_signup_states")
}

enum WhatsAppIntegrationStatus {
  PENDING
  CONNECTING
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECTED
  REVOKED
  ERROR
}

enum WhatsAppConnectionMethod {
  MANUAL
  EMBEDDED_SIGNUP
  COEXISTENCE
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────
// Per-user, per-company in-app notification. Never stores secrets, full
// WhatsApp message bodies, tokens, passwords, full IPs or sessions — only a
// short sanitized preview and minimal metadata. `dedupeKey` (unique) collapses
// bursts of the same event into one row.
model Notification {
  id              String               @id @default(cuid())
  companyId       String
  recipientUserId String
  actorUserId     String?
  type            String
  category        NotificationCategory
  priority        NotificationPriority @default(NORMAL)
  title           String
  bodyPreview     String?
  entityType      String?
  entityId        String?
  actionUrl       String?
  metadata        Json?
  dedupeKey       String?              @unique
  readAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipient User    @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, createdAt])
  @@index([companyId])
  @@index([expiresAt])
  @@map("notifications")
}

// One row per (user, category) — controls in-app + email delivery. Defaults are
// applied in code when a row is absent, so a new user needs no seeding.
model NotificationPreference {
  id           String               @id @default(cuid())
  companyId    String
  userId       String
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([companyId])
  @@map("notification_preferences")
}

enum NotificationCategory {
  CONVERSATION
  MESSAGE
  CONTACT
  LEAD
  TASK
  QUOTE
  WHATSAPP
  SECURITY
  PLATFORM
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Role {
  SUPER_ADMIN
  ADMIN

  /// Coordina el equipo sin administrar la empresa.
  ///
  /// EXISTE PORQUE ADMIN Y AGENT NO CUBREN EL HUECO REAL. Quien disena y
  /// publica bots necesita mas que un asesor y menos que un administrador:
  /// puede crear, editar, simular y publicar flujos, y ver todas las
  /// ejecuciones, pero NO toca credenciales, integraciones ni la
  /// configuracion de la empresa. Dar ADMIN a esa persona significa darle
  /// tambien las claves de WhatsApp y de los servicios externos.
  ///
  /// Se anade DESPUES de ADMIN a proposito: el orden de un enum de PostgreSQL
  /// es el de declaracion, y ninguna consulta del producto ordena por rol,
  /// pero si alguna lo hiciera, insertarlo en medio cambiaria resultados.
  MANAGER

  AGENT
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ─────────────────────────────────────────────
// PLATFORM AUDIT LOG
// ─────────────────────────────────────────────
model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String?
  actorRole         Role
  affectedCompanyId String?
  action            String
  entityType        String
  entityId          String?
  reason            String?
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  actor           User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  affectedCompany Company? @relation("AuditLogAffectedCompany", fields: [affectedCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([affectedCompanyId])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PLATFORM SUPPORT SESSIONS
// ─────────────────────────────────────────────
enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

model SupportSession {
  id          String               @id @default(cuid())
  actorUserId String
  companyId   String
  reason      String
  status      SupportSessionStatus @default(ACTIVE)
  expiresAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  actor   User    @relation(fields: [actorUserId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([actorUserId])
  @@index([companyId])
  @@index([status])
  @@index([expiresAt])
  @@map("support_sessions")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  // Tipos que Meta entrega y que hoy se descartaban en el webhook.
  STICKER
  LOCATION
  CONTACTS
  INTERACTIVE
  REACTION
  UNSUPPORTED
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

// ─────────────────────────────────────────────
// INVITATION CODES (company onboarding gate)
// ─────────────────────────────────────────────
enum InvitationCodeStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

model InvitationCode {
  id          String @id @default(cuid())
  // SHA-256 hex digest of the normalized plaintext code. The plaintext
  // itself is never stored — only shown once, in the create-response.
  codeHash    String @unique
  // Masked display form for the admin panel, e.g. "TEHUS-****-****-****-A7F2".
  codePreview String

  intendedCompanyName  String
  intendedContactEmail String?

  status    InvitationCodeStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  createdByUserId String
  createdBy       User   @relation("InvitationCodeCreatedBy", fields: [createdByUserId], references: [id])

  usedAt       DateTime?
  usedByUserId String?
  usedBy       User?     @relation("InvitationCodeUsedBy", fields: [usedByUserId], references: [id])
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])

  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       User?     @relation("InvitationCodeRevokedBy", fields: [revokedByUserId], references: [id])

  @@index([status])
  @@index([createdByUserId])
  @@index([companyId])
  @@map("invitation_codes")
}

// ─────────────────────────────────────────────
// SESSIONS, DEVICES & LOGIN ACTIVITY (platform monitoring)
// ─────────────────────────────────────────────
enum UserSessionStatus {
  ACTIVE
  LOGGED_OUT
  REVOKED
  EXPIRED
}

enum LoginEventStatus {
  SUCCESS
  FAILED
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

// One row per (userId, deviceIdHash) pair — logging in again from the same
// recognized browser updates this same row (status back to ACTIVE, fresh
// refreshTokenHash/lastLoginAt) instead of creating a duplicate, so "number
// of devices" is never inflated by repeat logins from the same browser.
model UserSession {
  id           String  @id @default(cuid())
  userId       String
  companyId    String?
  // SHA-256 hex digest of the random, persistent, cookie-based device
  // identifier — never the raw cookie value itself, and never derived from
  // IP, fonts, canvas, or any other invasive fingerprinting signal (see
  // DeviceIdMiddleware and buildSessionRequestContext).
  deviceIdHash String

  // SHA-256 hex digest of the opaque refresh token. The plaintext travels
  // only in an httpOnly cookie and is never persisted anywhere.
  refreshTokenHash String @unique

  // Anonymized, already-truncated IP — the only form ever stored or
  // returned: IPv4 has its last octet zeroed (181.60.12.0), IPv6 is
  // truncated to its first 3 hextets (2001:db8:1234::). The precise
  // address is never written to any column, log line, or API response —
  // see ip.util.ts#truncateIp.
  ipPreview String?

  // No raw User-Agent is ever persisted — only the coarse fields parsed
  // from it at write time (see user-agent.util.ts#parseUserAgent).
  browser         String?
  operatingSystem String?
  deviceType      DeviceType @default(UNKNOWN)

  status UserSessionStatus @default(ACTIVE)

  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  lastLoginAt    DateTime @default(now())
  // Throttled to at most one write every 5 minutes per session — see
  // ActivityThrottleInterceptor. Reflects "the session is still open", not
  // clicks or form content.
  lastActivityAt DateTime @default(now())

  loggedOutAt DateTime?
  revokedAt   DateTime?

  revokedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  revokedBy User?    @relation("UserSessionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, deviceIdHash])
  @@index([companyId])
  @@index([status])
  @@index([deviceIdHash])
  @@index([lastActivityAt])
  @@map("user_sessions")
}

// One row per login attempt, successful or not. Never linked to a password
// or token — only enough to power the platform's login-activity view.
model LoginEvent {
  id String @id @default(cuid())

  userId         String?
  companyId      String?
  // Kept even for FAILED attempts against a non-existent email (lowercased,
  // trimmed) — this is an internal audit row behind PlatformGuard, not a
  // client-facing message, so it does not itself "reveal" account
  // existence to anyone attempting to log in.
  emailAttempted String

  status        LoginEventStatus
  // A small fixed set of generic codes (e.g. INVALID_CREDENTIALS,
  // ACCOUNT_INACTIVE, COMPANY_SUSPENDED) — never the raw exception message.
  failureReason String?

  // See UserSession — same hashed-device and truncated-IP treatment, and
  // no raw User-Agent, only the parsed fields.
  deviceIdHash String?
  ipPreview    String?

  browser         String?
  operatingSystem String?
  deviceType      DeviceType @default(UNKNOWN)

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("login_events")
}

// Single-use, short-lived password-recovery tokens. Only the SHA-256 hex digest
// of the opaque token is ever stored (tokenHash) — the plaintext lives only in
// the emailed link and is never persisted, logged, or returned by the API. A new
// request invalidates the user's prior still-active tokens; consumption is
// atomic (see PasswordResetService). requestedIpPreview reuses the same
// truncated-IP anonymization as sessions (ip.util.ts) — never a raw address.
model PasswordResetToken {
  id                 String    @id @default(cuid())
  userId             String
  tokenHash          String    @unique
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  requestedIpPreview String?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────
// OUTBOX DURABLE
// ─────────────────────────────────────────────
// Resuelve la ventana entre "el dato ya está persistido" y "sus efectos se
// encolaron". Sin esto, si el proceso muere justo después del commit y antes
// del enqueue, el mensaje queda guardado y sus efectos no ocurren nunca: ni
// asignación, ni tarea, ni aviso al asesor. Nada lo detecta, porque no hay
// error en ningún log.
//
// El evento se escribe en LA MISMA TRANSACCIÓN que el cambio esencial, así
// que o existen ambos o no existe ninguno. Un dispatcher posterior lo empuja
// a la cola y lo marca completado.
model OutboxEvent {
  id   String @id @default(cuid())
  type String

  // Acotado por empresa como todo lo demás: un evento nunca es global.
  companyId String

  payload Json

  // Clave de deduplicación. UNIQUE: si el mismo hecho se registra dos veces
  // (reintento de Meta, reproceso), la segunda inserción falla y no se
  // duplican efectos. Suele ser el id del mensaje.
  idempotencyKey String @unique

  status   OutboxStatus @default(PENDING)
  attempts Int          @default(0)

  // Cuándo puede volver a intentarse. El backoff se materializa aquí, de modo
  // que sobrevive a un reinicio: un retraso en memoria se perdería.
  availableAt DateTime @default(now())

  // Clasificador ya redactado; NUNCA el payload crudo del error, que puede
  // arrastrar PII o secretos.
  lastError String?

  // Marca de cuándo se reclamó, para poder recuperar los que quedaron
  // colgados si el proceso murió a mitad.
  claimedAt   DateTime?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // El índice que usa el dispatcher para reclamar lotes.
  @@index([status, availableAt])
  @@index([companyId, status])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────
// LATIDO DE COMPONENTES
// ─────────────────────────────────────────────

/// Ultima senal de vida de cada proceso de fondo.
///
/// EXISTE PORQUE EL WORKER NO EXPONE PUERTO. No tiene endpoint que sondear, y
/// preguntarle a Redis si el worker vive no sirve: Redis puede estar
/// perfectamente y el worker muerto, que es justo el caso peor —los eventos
/// se encolan, nadie los consume y todo parece sano—.
///
/// Vive en PostgreSQL y no en Redis a proposito: si el latido dependiera de
/// Redis, una caida de Redis borraria la evidencia de la caida del worker.
model SystemHeartbeat {
  /// Nombre del componente: `queue-worker`, y los que vengan.
  component String @id

  seenAt DateTime @updatedAt

  /// Datos no sensibles para diagnostico: release y pid. Nunca secretos.
  detail Json?

  @@map("system_heartbeats")
}

/// Hasta donde ha leido CADA usuario en una conversacion.
///
/// Es por usuario y no un booleano en la conversacion porque la bandeja es
/// compartida: que un supervisor abra un hilo no significa que el asesor
/// asignado ya lo haya visto, y un unico `isRead` haria desaparecer el aviso
/// de la persona equivocada.
///
/// Se guarda una MARCA DE TIEMPO y no un contador: los mensajes nuevos llegan
/// despues, asi que "no leidos" se deriva comparando `lastReadAt` con la fecha
/// de los mensajes entrantes. Un contador habria que mantenerlo sincronizado
/// en cada alta y se desincroniza en cuanto algo falla a medias.
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_reads")
}

// ─────────────────────────────────────────────
// CHATBOT
// ─────────────────────────────────────────────

enum ChatbotFlowStatus {
  DRAFT
  PUBLISHED
}

/// Un flujo de chatbot.
///
/// BORRADOR Y PUBLICADO SON DOS COSAS DISTINTAS a proposito: el flujo se edita
/// mientras hay clientes conversando con la version anterior. Sin esa
/// separacion, guardar a media edicion dejaria a la gente a mitad de un flujo
/// que ya no existe.
model ChatbotFlow {
  id       String            @id @default(cuid())
  name     String
  status   ChatbotFlowStatus @default(DRAFT)
  isActive Boolean           @default(false)

  /// Definicion EN EDICION. Nunca es la que atiende a nadie.
  draftNodes Json

  /// Version publicada vigente. `null` = nunca se ha publicado.
  publishedVersion Int?

  /// Palabras que lo inician. Vacio = se inicia con cualquier primer mensaje.
  triggerKeywords String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  versions ChatbotFlowVersion[]
  sessions ChatbotSession[]

  @@index([companyId, isActive])
  @@map("chatbot_flows")
}

/// Foto inmutable de un flujo publicado.
///
/// Las sesiones apuntan a la VERSION, no al flujo: quien empezo a conversar
/// con la version 3 la termina con la version 3 aunque se publique la 4 a
/// mitad. Cambiarle el flujo bajo los pies a alguien que esta respondiendo
/// preguntas es la forma mas rapida de dejarlo en un nodo que ya no existe.
model ChatbotFlowVersion {
  id      String @id @default(cuid())
  version Int
  nodes   Json

  publishedBy String?
  publishedAt DateTime @default(now())

  flowId String
  flow   ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  sessions ChatbotSession[]

  @@unique([flowId, version])
  @@map("chatbot_flow_versions")
}

enum ChatbotSessionStatus {
  ACTIVE
  /// Paso a manos de una persona. Terminal: el bot no la retoma solo.
  HANDED_OVER
  COMPLETED
  /// Sin respuesta del cliente durante demasiado tiempo.
  ABANDONED
}

/// Estado de una conversacion dentro de un flujo.
///
/// UNA POR CONVERSACION ACTIVA. El indice parcial que lo garantiza vive en el
/// SQL de la migracion: Prisma no sabe expresar indices parciales, y sin el,
/// dos mensajes simultaneos abririan dos sesiones y el cliente veria el flujo
/// duplicado.
model ChatbotSession {
  id String @id @default(cuid())

  status      ChatbotSessionStatus @default(ACTIVE)
  currentNode String

  /// Respuestas recogidas hasta ahora. Es lo que permite que un flujo
  /// pregunte el nombre en el paso 1 y lo use en el paso 4.
  context Json?

  /// Cuantos mensajes lleva. Corta bucles: un flujo mal construido que se
  /// apunte a si mismo dejaria de responder en vez de escribir sin parar al
  /// cliente.
  steps Int @default(0)

  startedAt         DateTime  @default(now())
  lastInteractionAt DateTime  @default(now())
  endedAt           DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  flowId String
  flow   ChatbotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  flowVersionId String
  flowVersion   ChatbotFlowVersion @relation(fields: [flowVersionId], references: [id])

  @@index([conversationId, status])
  @@index([companyId, status, lastInteractionAt])
  @@map("chatbot_sessions")
}

enum DataRequestType {
  /// Copia de los datos de la empresa.
  EXPORT
  /// Solicitud de eliminacion. NO borra: registra y espera aprobacion.
  DELETION
}

enum DataRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

/// Solicitud de exportacion o eliminacion de datos.
///
/// LA ELIMINACION NO SE EJECUTA AL PEDIRLA. Se registra, queda PENDING y
/// exige una aprobacion aparte. Un endpoint que borrase el historial completo
/// de una empresa en una sola llamada es exactamente el tipo de accion que no
/// deberia existir: irreversible, disparable por error y sin rastro de quien
/// la pidio.
model DataRequest {
  id     String            @id @default(cuid())
  type   DataRequestType
  status DataRequestStatus @default(PENDING)

  /// Por que se pide. Obligatorio: una solicitud sin motivo no se puede
  /// revisar ni defender despues.
  reason String

  requestedBy String?
  approvedBy  String?

  /// Quien la ejecuto, que puede no ser quien la aprobo. Separar los tres
  /// papeles -pedir, aprobar, ejecutar- es lo que permite exigir que no sean
  /// la misma persona.
  executedBy String?

  /// Confirmacion escrita a mano por quien ejecuta. Se compara con el nombre
  /// de la empresa: teclear el nombre completo es la ultima barrera antes de
  /// un borrado irreversible, y la unica que no se pasa por accidente.
  confirmationText String?

  /// Motivo del rechazo, si se rechaza. Obligatorio: rechazar sin explicar
  /// deja a quien lo pidio sin saber que corregir.
  rejectionReason String?

  /// Resumen de lo hecho: cuantas filas por tabla. Sin contenido.
  result Json?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([status, requestedAt])
  @@map("data_requests")
}

enum MessageSource {
  /// Llegado por webhook en tiempo real. Dispara efectos.
  LIVE
  /// Sincronizacion de historial que envia Meta al conectar en coexistencia.
  /// Llega una sola vez y NO dispara efectos.
  HISTORY_SYNC
  /// Importacion controlada desde CSV. Tampoco dispara efectos.
  CSV_IMPORT
}

// ─────────────────────────────────────────────
// TAKTO FLOWBOT — constructor visual de bots
// ─────────────────────────────────────────────
//
// POR QUE MODELOS NUEVOS Y NO AMPLIAR ChatbotFlow: el chatbot v1 esta
// desplegado y con datos en staging. Su grafo es lineal (`next` mas opciones
// de menu) y su ejecucion es sincrona dentro del webhook; FlowBot necesita un
// grafo con puertos tipados, ejecucion durable, esperas que sobreviven a un
// reinicio y disparadores que no son solo "mensaje entrante". Forzar ambas
// semanticas sobre las mismas tablas dejaria filas que significan una cosa u
// otra segun una bandera, que es la clase de ambiguedad que despues nadie se
// atreve a tocar.
//
// El chatbot v1 se conserva intacto y sigue funcionando. FlowBot lo sustituye
// cuando cubra su superficie; hasta entonces conviven y NO compiten por la
// misma conversacion (ver la politica de seleccion en FlowBotTrigger).

enum FlowBotStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Un bot. Contenedor estable: lo que cambia son sus versiones.
model FlowBot {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      FlowBotStatus @default(DRAFT)

  /// Grafo en edicion. Cambia con cada autosave; nunca se ejecuta.
  draftGraph Json

  /// Version publicada que ejecuta el motor. Nula mientras solo hay borrador.
  publishedVersionId String?         @unique
  publishedVersion   FlowBotVersion? @relation("FlowBotPublished", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  /// Contador monotono de versiones. No se reutiliza al borrar.
  lastVersionNumber Int @default(0)

  /// Control de concurrencia optimista del borrador: dos pestanas abiertas
  /// sobre el mismo bot no pueden pisarse en silencio.
  draftRevision Int @default(0)

  /// Marca las plantillas del catalogo. Una plantilla se clona, nunca se
  /// ejecuta: por eso vive en la misma tabla en vez de en una paralela que
  /// habria que mantener en sincronia con el formato del grafo.
  isTemplate  Boolean @default(false)
  templateKey String?

  /// De que plantilla o bot se clono, para poder rastrear el origen.
  clonedFromId String?

  createdById String?
  createdBy   User?   @relation("FlowBotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("FlowBotUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  versions   FlowBotVersion[]   @relation("FlowBotVersions")
  triggers   FlowBotTrigger[]
  executions FlowBotExecution[]
  metrics    FlowBotMetric[]
  testRuns   FlowBotTestRun[]

  @@index([companyId, status])
  @@index([companyId, isTemplate])
  @@map("flowbots")
}

/// Version publicada. INMUTABLE: editar crea un borrador nuevo, nunca cambia
/// una version que puede tener ejecuciones vivas apuntando a ella.
model FlowBotVersion {
  id      String @id @default(cuid())
  version Int

  /// Grafo tal cual lo dibujo el autor, para poder restaurarlo como borrador.
  graph Json

  /// Grafo compilado: indices de nodo, puertos resueltos y orden de
  /// evaluacion. Es lo que lee el motor, para no recorrer el grafo crudo en
  /// cada paso.
  compiled Json

  /// Huella del compilado. Permite detectar que dos versiones son iguales y
  /// comprobar que una ejecucion no cambio de definicion a mitad.
  compiledHash String

  publishNote   String?
  publishedById String?
  publishedBy   User?    @relation("FlowBotVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now())

  flowBotId String
  flowBot   FlowBot @relation("FlowBotVersions", fields: [flowBotId], references: [id], onDelete: Cascade)

  /// Lado inverso de FlowBot.publishedVersion.
  publishedFor FlowBot? @relation("FlowBotPublished")

  executions FlowBotExecution[]
  metrics    FlowBotMetric[]
  testRuns   FlowBotTestRun[]

  @@unique([flowBotId, version])
  @@index([flowBotId, publishedAt])
  @@map("flowbot_versions")
}

enum FlowBotTriggerType {
  INBOUND_MESSAGE
  FIRST_CONVERSATION
  KEYWORD
  INTENT
  CONVERSATION_CREATED
  CONTACT_CREATED
  LEAD_CREATED
  STAGE_CHANGED
  TAG_ADDED
  TASK_OVERDUE
  NO_REPLY
  SCHEDULE
  MANUAL
  WEBHOOK
  AUTOMATION_EVENT
}

/// Cuando arranca un bot y con que filtros.
///
/// Vive en su propia tabla y no dentro del grafo porque hay que CONSULTARLO:
/// al llegar un mensaje se buscan los disparadores candidatos de esa empresa y
/// ese numero. Metido en el JSON del grafo habria que leer todos los bots de
/// la empresa y deserializarlos en cada mensaje.
model FlowBotTrigger {
  id      String             @id @default(cuid())
  type    FlowBotTriggerType
  enabled Boolean            @default(true)

  /// Desempate cuando varios disparadores encajan con el mismo evento. Mayor
  /// gana. Sin esto, el bot elegido dependeria del orden de la base — es
  /// decir, del azar.
  priority Int @default(0)

  /// Si es exclusivo, ningun otro bot arranca para esa conversacion.
  exclusive Boolean @default(true)

  /// Filtros del disparador (palabras, etapa, etiqueta, horario, campos...).
  /// Su forma depende de `type` y la valida el compilador.
  filters Json?

  /// Numero concreto de WhatsApp. Nulo = cualquiera de la empresa.
  whatsappIntegrationId String?
  whatsappIntegration   WhatsAppIntegration? @relation(fields: [whatsappIntegrationId], references: [id], onDelete: Cascade)

  /// Para SCHEDULE: expresion horaria ya normalizada y proxima ejecucion.
  scheduleSpec String?
  nextRunAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flowBotId String
  flowBot   FlowBot @relation(fields: [flowBotId], references: [id], onDelete: Cascade)

  @@index([flowBotId])
  @@index([type, enabled])
  @@index([whatsappIntegrationId, enabled])
  @@index([nextRunAt])
  @@map("flowbot_triggers")
}

enum FlowBotExecutionStatus {
  RUNNING
  WAITING_INPUT
  WAITING_TIME
  HANDED_OFF
  COMPLETED
  FAILED
  CANCELLED
  PAUSED

  /// La ejecucion quedo en un estado que el sistema NO puede resolver solo.
  ///
  /// EXISTE PARA NO REPETIR UN EFECTO EXTERNO A CIEGAS. Cuando un lease vence
  /// a mitad de un paso que ya pudo haber mandado un WhatsApp, cobrado algo o
  /// llamado a un tercero, hay dos opciones malas: reintentar —y quiza
  /// duplicarlo— o abandonar —y quiza dejarlo a medias—. Si el motor no puede
  /// PROBAR que el efecto no ocurrio, no elige ninguna: para la ejecucion
  /// aqui y deja que lo mire una persona.
  ///
  /// No es un estado final: desde aqui se puede reanudar o cancelar a mano.
  NEEDS_ATTENTION
}

/// Una ejecucion del bot sobre una conversacion. Es el estado durable: si el
/// worker muere a mitad, esta fila es lo que permite retomar.
model FlowBotExecution {
  id     String                 @id @default(cuid())
  status FlowBotExecutionStatus @default(RUNNING)

  /// Nodo en el que esta parada la ejecucion.
  currentNodeId String?

  /// Variables acumuladas. Solo datos del flujo; NUNCA secretos ni
  /// credenciales: esas viven cifradas y se referencian por id.
  variables Json @default("{}")

  /// Tope de pasos consumidos, para cortar bucles que el validador no pudo
  /// descartar estaticamente.
  steps Int @default(0)

  /// Idempotencia del ARRANQUE: dos entregas del mismo webhook no pueden
  /// abrir dos ejecuciones. Se construye con empresa, bot, disparador y
  /// evento (por ejemplo el wamid).
  idempotencyKey String @unique

  /// Para correlacionar logs, pasos y eventos de outbox de una misma cadena.
  correlationId String

  /// Profundidad de encadenamiento entre automatizaciones y bots. Es lo que
  /// impide que un bot dispare una automatizacion que dispare al bot.
  depth Int @default(0)

  /// Clasificador de error ya redactado. Nunca el mensaje crudo del
  /// proveedor: ese arrastra telefonos y cuerpos de peticion.
  errorCode String?

  /// Por que necesita revision humana. Clasificador corto, nunca texto libre
  /// del cliente ni respuesta del proveedor.
  attentionReason String?

  /// Cuantas veces el reconciliador ha tenido que intervenir sobre esta
  /// ejecucion. Un numero que sube sin parar es la senal de que algo esta
  /// roto de verdad y no es un tropiezo aislado.
  recoveries Int @default(0)

  /// Cuando intervino por ultima vez. Con `recoveries` permite distinguir
  /// "se recupero una vez hace un mes" de "lleva media hora en bucle".
  lastRecoveryAt DateTime?

  /// Por que termino: fin normal, cancelacion, transferencia, tope de pasos.
  endedReason String?

  /// Quien esta avanzando esta ejecucion ahora mismo, y hasta cuando.
  ///
  /// Es el lease que impide que dos workers la avancen a la vez: un reintento
  /// de BullMQ y una continuacion pueden coincidir, y el cliente recibiria dos
  /// respuestas. Se toma con una escritura condicional, no con un `findFirst`
  /// seguido de `update`, porque entre esas dos operaciones hay un hueco por
  /// el que otro worker se cuela.
  ///
  /// Con vencimiento a proposito: si el proceso que lo tenia muere, nadie
  /// libera el lease y la ejecucion quedaria bloqueada para siempre.
  leaseOwner String?
  leaseUntil DateTime?

  startedAt  DateTime  @default(now())
  lastStepAt DateTime  @default(now())
  endedAt    DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  flowBotId String
  flowBot   FlowBot @relation(fields: [flowBotId], references: [id], onDelete: Cascade)

  versionId String
  version   FlowBotVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Numero por el que entro. Se responde SIEMPRE por aqui: con varios
  /// numeros, contestar desde el principal manda la respuesta desde un numero
  /// que el cliente no reconoce.
  whatsappIntegrationId String?
  whatsappIntegration   WhatsAppIntegration? @relation(fields: [whatsappIntegrationId], references: [id], onDelete: SetNull)

  /// Mensaje que la disparo, para poder auditar el origen.
  triggerMessageId String?

  executionSteps FlowBotExecutionStep[]
  waits          FlowBotWait[]

  @@index([companyId, status])
  @@index([conversationId, status])
  @@index([flowBotId, startedAt])
  @@index([versionId])
  @@index([companyId, startedAt])
  @@index([status, leaseUntil])
  /// Para el reconciliador: barre por estado y por cuanto lleva sin avanzar.
  /// Sin este indice, cada pase leeria la tabla entera de ejecuciones.
  @@index([status, lastStepAt])
  @@map("flowbot_executions")
}

enum FlowBotStepStatus {
  OK
  FAILED
  SKIPPED
}

/// Un paso ejecutado. Es la caja negra: sin esto, "el bot no hizo nada" no
/// tiene respuesta posible.
model FlowBotExecutionStep {
  id       String            @id @default(cuid())
  nodeId   String
  nodeType String
  status   FlowBotStepStatus @default(OK)

  /// Puerto por el que salio (next, true, false, timeout, error...).
  outPort String?

  /// Entrada y salida ya redactadas: sirven para depurar sin volcar el texto
  /// completo del cliente.
  input  Json?
  output Json?

  errorCode  String?
  durationMs Int?

  /// Idempotencia POR PASO: un reintento del mismo paso no repite su efecto
  /// externo (crear una tarea, enviar un mensaje).
  idempotencyKey String? @unique

  attempt   Int      @default(1)
  createdAt DateTime @default(now())

  executionId String
  execution   FlowBotExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, createdAt])
  @@index([nodeType, status])
  @@map("flowbot_execution_steps")
}

enum FlowBotWaitKind {
  INPUT
  TIME
  EVENT
}

/// Una espera pendiente. Vive en PostgreSQL y no en Redis a proposito: una
/// espera de tres dias no puede depender de que la cola conserve el trabajo.
model FlowBotWait {
  id   String          @id @default(cuid())
  kind FlowBotWaitKind

  /// Cuando reanudar. Para INPUT es el vencimiento, si lo hay.
  wakeAt DateTime?

  /// Nodo al que volver al reanudar.
  resumeNodeId String

  /// Puerto por el que salir si vence sin respuesta.
  timeoutPort String?

  /// Para EVENT: que evento se espera.
  eventKey String?

  /// Se marca en vez de borrarse: una espera consumida es evidencia de por
  /// que la ejecucion siguio, y borrarla dejaria el historial cojo.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  executionId String
  execution   FlowBotExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([wakeAt, consumedAt])
  @@index([executionId, consumedAt])
  @@index([companyId, kind, consumedAt])
  @@map("flowbot_waits")
}

/// Contadores agregados por bot, version y dia.
///
/// Agregado y no calculado al vuelo: contar ejecuciones de meses sobre la
/// tabla de pasos convierte el panel en una consulta lenta que ademas crece
/// sin limite.
model FlowBotMetric {
  id  String   @id @default(cuid())
  day DateTime @db.Date

  executionsStarted   Int @default(0)
  executionsCompleted Int @default(0)
  executionsFailed    Int @default(0)
  executionsCancelled Int @default(0)
  handedOff           Int @default(0)
  messagesSent        Int @default(0)
  templatesSent       Int @default(0)
  contactsCaptured    Int @default(0)
  leadsCreated        Int @default(0)
  tasksCreated        Int @default(0)
  aiCalls             Int @default(0)

  /// Coste estimado en milesimas de la moneda, para no perder precision con
  /// decimales de coma flotante.
  aiCostMillis Int @default(0)

  totalDurationMs BigInt @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  flowBotId String
  flowBot   FlowBot @relation(fields: [flowBotId], references: [id], onDelete: Cascade)

  versionId String?
  version   FlowBotVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@unique([flowBotId, versionId, day])
  @@index([companyId, day])
  @@map("flowbot_metrics")
}

/// Resultado de una simulacion. NUNCA produce efectos reales: los adaptadores
/// del simulador son falsos y lo que aqui se guarda es la traza.
model FlowBotTestRun {
  id String @id @default(cuid())

  /// Escenario de entrada: mensajes, variables y contacto ficticio.
  scenario Json

  /// Traza de nodos recorridos, ramas tomadas y variables.
  trace Json

  /// Efectos que SE HABRIAN producido, para poder revisarlos sin causarlos.
  effects Json?

  passed  Boolean @default(true)
  summary String?

  createdById String?
  createdBy   User?    @relation("FlowBotTestRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  flowBotId String
  flowBot   FlowBot @relation(fields: [flowBotId], references: [id], onDelete: Cascade)

  versionId String?
  version   FlowBotVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([flowBotId, createdAt])
  @@map("flowbot_test_runs")
}

// ─────────────────────────────────────────────
// ENTRADA AUTOMATICA DE OPORTUNIDADES
// ─────────────────────────────────────────────

enum EstrategiaAsignacion {
  /// Nadie: la oportunidad queda sin responsable hasta que alguien la tome.
  NINGUNA
  /// Reparto por turnos entre quienes estan disponibles.
  ROUND_ROBIN
  /// Siempre a la misma persona.
  FIJA
}

/// Que hace el CRM cuando entra un mensaje de alguien nuevo.
///
/// VIVE EN SU PROPIA TABLA y no como columnas de `Company` por dos razones:
/// `Company` ya tiene mas de treinta campos y sigue creciendo, y esto es una
/// unidad de configuracion que se consulta entera o no se consulta — cada
/// mensaje entrante la lee de una vez.
///
/// Una empresa SIN fila aqui usa los valores por defecto documentados, que son
/// los que el producto ya venia aplicando. Nadie tiene que configurar nada
/// para que el CRM siga funcionando igual que antes.
model CompanyLeadSettings {
  id String @id @default(cuid())

  /// Crear oportunidad al recibir un mensaje. Apagarlo deja el CRM como una
  /// bandeja: contacto y conversacion si, pipeline no.
  autoCreateLead Boolean @default(true)

  /// Pipeline donde entra. Nulo = el predeterminado de la empresa.
  defaultPipelineId String?
  defaultPipeline   Pipeline? @relation("LeadSettingsPipeline", fields: [defaultPipelineId], references: [id], onDelete: SetNull)

  /// Etapa de entrada. Nula = la marcada como inicial en ese pipeline.
  ///
  /// Se guarda el ID y no el nombre a proposito: llamarla "Nuevo lead" es una
  /// decision de cada empresa, y atar el comportamiento a un texto lo rompe en
  /// cuanto alguien la renombra o trabaja en otro idioma.
  initialStageId String?
  initialStage   PipelineStage? @relation("LeadSettingsStage", fields: [initialStageId], references: [id], onDelete: SetNull)

  /// Reutilizar la oportunidad abierta del contacto en vez de abrir otra.
  /// Apagarlo hace que cada conversacion nueva abra su propia oportunidad.
  reuseOpenLead Boolean @default(true)

  /// Crear una tarea de primer contacto junto con la oportunidad.
  createInitialTask   Boolean @default(false)
  initialTaskTitle    String?
  /// Horas hasta el vencimiento de esa tarea.
  initialTaskDueHours Int     @default(24)

  assignmentStrategy EstrategiaAsignacion @default(ROUND_ROBIN)
  /// Para `FIJA`: a quien.
  assignedUserId     String?
  assignedUser       User?                @relation("LeadSettingsUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Que hacer cuando vuelve a escribir un contacto archivado.
  /// `true` lo reactiva solo; `false` lo deja archivado y registra el evento.
  reactivateArchived Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_lead_settings")
}

// ─────────────────────────────────────────────
// CAMPOS PERSONALIZADOS
// ─────────────────────────────────────────────

/// Que clase de dato guarda un campo. Decide como se valida, como se
/// almacena y como se muestra.
enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  DATE
  DATETIME
  BOOLEAN
  SELECT
  MULTI_SELECT
  PHONE
  EMAIL
  URL
}

/// A que se le pueden colgar campos personalizados.
///
/// Se modela como enum y no como tabla polimorfica libre porque el conjunto
/// es cerrado y conocido: asi las claves ajenas siguen siendo reales y la
/// base puede garantizar que un valor apunta a algo que existe.
enum CustomFieldEntity {
  CONTACT
  LEAD
}

/// Quien cambio un valor. Un bot y una persona no son lo mismo y mezclarlos
/// haria inutil el historial justo cuando hace falta.
enum CustomFieldSource {
  USER
  FLOWBOT
  AUTOMATION
  IMPORT
  API
}

/// Definicion de un campo personalizado de una empresa.
///
/// LA CLAVE ES `key`, NO EL NOMBRE VISIBLE. Renombrar "Cedula" a "Documento"
/// no puede romper los flujos que escriben en ese campo; si la referencia
/// fuese la etiqueta, cualquier correccion de texto dejaria bots apuntando a
/// un campo que ya no existe.
model CustomFieldDefinition {
  id String @id @default(cuid())

  entity CustomFieldEntity
  /// Identificador estable dentro de (empresa, entidad). Minusculas,
  /// numeros y guion bajo.
  key    String
  label  String
  type   CustomFieldType

  /// Ayuda corta para quien rellena el campo en la interfaz.
  helpText String?

  /// Opciones de SELECT y MULTI_SELECT: `[{ value, label }]`. Se guardan como
  /// JSON porque su numero y su texto los define cada empresa.
  options Json?

  /// Reglas extra segun el tipo: `minLength`, `maxLength`, `min`, `max`,
  /// `pattern`. Es JSON por la misma razon, y se valida al guardarlo para que
  /// una regla imposible no se acepte en silencio.
  validation Json?

  /// Orden de presentacion. No se usa para nada semantico: reordenar la
  /// interfaz nunca puede cambiar a que campo escribe un bot.
  order Int @default(0)

  /// Un campo inactivo deja de ofrecerse y deja de aceptar escrituras nuevas,
  /// pero NO borra los valores ya capturados: son datos del cliente.
  isActive   Boolean @default(true)
  isRequired Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  values  CustomFieldValue[]
  changes CustomFieldValueChange[]

  @@unique([companyId, entity, key])
  @@index([companyId, entity, isActive, order])
  @@map("custom_field_definitions")
}

/// Valor de un campo personalizado para un contacto o una oportunidad.
///
/// EL VALOR VA EN COLUMNAS TIPADAS, no en un JSON opaco. Con JSON, "12" y 12
/// conviven, ordenar por un numero ordena alfabeticamente y filtrar por rango
/// de fechas es imposible sin castear en cada consulta. Cada tipo escribe en
/// la columna que le corresponde y las demas quedan nulas.
///
/// El `companyId` esta DUPLICADO a proposito respecto de la definicion: cada
/// consulta filtra por el sin tener que unir dos tablas, y una fila mal
/// construida se detecta comparandolos.
model CustomFieldValue {
  id String @id @default(cuid())

  /// TEXT, LONG_TEXT, PHONE, EMAIL, URL y SELECT.
  valueText String?
  /// NUMBER y CURRENCY. Decimal y no Float: la moneda en coma flotante es
  /// como se acaba con centavos que no cuadran.
  valueNumber Decimal? @db.Decimal(18, 6)
  /// BOOLEAN.
  valueBool Boolean?
  /// DATE y DATETIME. DATE se normaliza a medianoche en la zona de la
  /// empresa antes de guardarse.
  valueDate DateTime?
  /// MULTI_SELECT.
  valueList String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  /// Exactamente uno de los dos esta puesto. Lo garantiza un CHECK escrito a
  /// mano en la migracion, porque Prisma no sabe expresarlo.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([definitionId, contactId])
  @@unique([definitionId, leadId])
  @@index([companyId, definitionId])
  @@index([contactId])
  @@index([leadId])
  @@map("custom_field_values")
}

/// Historial de cambios de un valor.
///
/// EXISTE PORQUE UN CAMPO PERSONALIZADO GUARDA DATOS DEL CLIENTE. Cuando
/// alguien pregunte por que su "estado de credito" cambio, la respuesta no
/// puede ser "no lo sabemos". Guarda el antes y el despues ya serializados a
/// texto, el origen y, si lo hubo, la ejecucion de FlowBot que lo provoco.
///
/// NO usa `AuditLog`: ese exige un rol de actor y registra lo que hace una
/// PERSONA. Un bot no tiene rol, y meterlo con uno inventado convertiria la
/// auditoria en algo que miente sobre quien hizo que.
///
/// Crece con cada escritura. Necesita politica de retencion antes de que el
/// volumen importe; queda anotado en el estado del proyecto.
model CustomFieldValueChange {
  id String @id @default(cuid())

  /// Serializados a texto para que el historial siga siendo legible aunque el
  /// tipo del campo cambie despues.
  previousValue String?
  newValue      String?

  source CustomFieldSource @default(USER)

  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  entity   CustomFieldEntity
  /// Id del contacto o de la oportunidad. Sin clave ajena a proposito: el
  /// historial debe sobrevivir al borrado de la entidad, que es justo cuando
  /// mas falta hace saber que habia.
  entityId String

  /// Quien lo cambio, cuando fue una persona.
  actorUserId String?
  actor       User?   @relation("CustomFieldChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Que ejecucion lo provoco, cuando fue un bot.
  executionId String?

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@index([definitionId, createdAt])
  @@map("custom_field_value_changes")
}

// ─────────────────────────────────────────────
// HANDOFF A UNA PERSONA
// ─────────────────────────────────────────────

/// Estados de una entrega a una persona.
///
/// `ACTIVE` es el unico que silencia al bot. Los otros dos son finales y se
/// distinguen porque no significan lo mismo: `RESOLVED` es "la persona lo
/// atendio", `CANCELLED` es "se retiro sin atenderlo" —por ejemplo al
/// cancelar la ejecucion entera—. Meterlos en el mismo cajon haria imposible
/// medir cuantas entregas se quedaron sin respuesta.
enum HandoffStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

/// Una conversacion entregada a una persona.
///
/// EXISTE COMO TABLA Y NO COMO BANDERA porque `Conversation.isPaused` no
/// puede responder ninguna de las preguntas que importan: quien la atiende,
/// por que se entrego, que bot y que nodo lo decidieron, cuando, y si ya se
/// resolvio. Una bandera solo dice "el bot calla", y cuando alguien pregunta
/// por que, no hay respuesta.
///
/// `isPaused` se sigue manteniendo en sincronia a proposito: es lo que ya
/// consultan el chatbot heredado y el intake de FlowBot, y hacer que dos
/// motores dependan de una tabla nueva sin necesidad seria arriesgar el
/// silencio del bot por un refactor.
model ConversationHandoff {
  id     String        @id @default(cuid())
  status HandoffStatus @default(ACTIVE)

  /// Clasificador corto de por que se entrego. Nunca el texto del cliente.
  reason String?

  /// Nota que dejo el bot para quien recoja la conversacion.
  note String?

  startedAt  DateTime  @default(now())
  resolvedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// A quien se entrego. Nulo significa "a la bandeja comun".
  ///
  /// NO HAY EQUIPOS EN EL ESQUEMA todavia, asi que no se inventa una columna
  /// que no apunte a ninguna tabla. Cuando existan, este modelo gana un
  /// `teamId` nulable y la regla pasa a ser "usuario o equipo, o ninguno".
  assignedToUserId String?
  assignedTo       User?   @relation("HandoffAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  /// Quien lo dio por resuelto y devolvio la conversacion al bot, si alguien
  /// lo hizo.
  resolvedByUserId String?
  resolvedBy       User?   @relation("HandoffResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  /// Que ejecucion y que nodo lo originaron. Sin clave ajena a la ejecucion:
  /// el handoff debe sobrevivir a la limpieza de ejecuciones antiguas, que es
  /// justo cuando hace falta saber de donde salio.
  executionId String?
  nodeId      String?

  /// Tarea creada al entregar, si se creo. Permite cerrarla al resolver.
  taskId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status, startedAt])
  @@index([conversationId, status])
  @@index([assignedToUserId, status])
  @@map("conversation_handoffs")
}

// ─────────────────────────────────────────────
// INTEGRACIONES DE FLOWBOT (HTTP e IA)
// ─────────────────────────────────────────────

/// Como se autentica una llamada HTTP saliente.
///
/// Es un conjunto CERRADO. Dejar que un flujo componga cabeceras arbitrarias
/// convierte el nodo HTTP en un proxy con las credenciales de la empresa
/// dentro, y ese es exactamente el agujero que un motor de automatizaciones no
/// puede tener.
enum FlowBotCredentialType {
  /// Una cabecera con nombre configurable: `X-API-Key: <secreto>`.
  API_KEY_HEADER
  /// `Authorization: Bearer <secreto>`.
  BEARER_TOKEN
  /// `Authorization: Basic base64(usuario:secreto)`.
  BASIC_AUTH
}

/// Credencial de un servicio externo, guardada CIFRADA.
///
/// EL SECRETO NUNCA VIAJA AL FLUJO. Un nodo referencia la credencial por id;
/// el adaptador la descifra en memoria justo antes de la llamada y la olvida.
/// Si el flujo pudiera leerla, cualquiera con permiso para editar un bot
/// podria exfiltrarla mandandosela a si mismo con otro nodo HTTP.
model FlowBotCredential {
  id   String                @id @default(cuid())
  name String
  type FlowBotCredentialType

  /// Nombre de la cabecera para API_KEY_HEADER. Se valida contra una lista de
  /// caracteres seguros: una cabecera con salto de linea permite inyectar
  /// otras.
  headerName String?

  /// Usuario de BASIC_AUTH. No es secreto, va en claro.
  username String?

  /// AES-256-GCM con la misma clave que los tokens de WhatsApp.
  secretEncrypted String

  /// Cuando se uso por ultima vez. Permite retirar las que ya nadie usa sin
  /// adivinar.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("flowbot_credentials")
}

/// Configuracion de las integraciones de FlowBot, por empresa.
///
/// TODO VIENE APAGADO. Un motor que puede llamar a cualquier URL y a un
/// proveedor de IA de pago desde el minuto cero es una factura y una fuga
/// esperando a ocurrir. Encenderlo es una decision explicita de la empresa, y
/// el validador impide publicar un flujo que use lo que no esta encendido.
model FlowBotSettings {
  id String @id @default(cuid())

  // ── HTTP ──
  httpEnabled Boolean @default(false)

  /// Hosts permitidos. VACIO significa "ninguno": una lista vacia no es
  /// "todos". Al reves, encender HTTP sin configurar nada abriria la salida a
  /// internet entero, que es justo lo que la lista existe para evitar.
  httpAllowedHosts String[]

  httpTimeoutMs        Int @default(10000)
  /// Tope de respuesta. Sin el, un servidor que devuelve un gigabyte tumba el
  /// worker por memoria.
  httpMaxResponseBytes Int @default(262144)

  // ── IA ──
  aiEnabled  Boolean @default(false)
  /// Identificador del proveedor. El motor NO conoce ninguno: lo resuelve el
  /// registro de proveedores, y sin registro la IA queda "sin configurar".
  aiProvider String?
  aiModel    String?

  /// Clave del proveedor, cifrada igual que el resto.
  aiApiKeyEncrypted String?

  /// Topes de gasto. Se cuentan por empresa y por dia.
  aiMaxTokensPerCall Int @default(500)
  aiMaxCallsPerDay   Int @default(500)
  aiTimeoutMs        Int @default(15000)

  /// Redactar telefonos, correos y documentos antes de mandar el texto al
  /// proveedor. Por defecto SI: lo que sale del CRM ya no vuelve.
  aiRedactPii Boolean @default(true)

  /// Instrucciones del sistema. Separadas del prompt del nodo a proposito: el
  /// autor de un flujo no puede reescribir las reglas de la empresa desde el
  /// texto de un nodo.
  aiSystemPrompt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("flowbot_settings")
}

/// Consumo de IA, para poder aplicar los topes y explicar la factura.
///
/// Una fila por empresa y dia. Sin esto los limites serian una promesa: no se
/// puede impedir la llamada 501 si nadie ha contado las 500 anteriores.
model FlowBotAiUsage {
  id  String   @id @default(cuid())
  day DateTime @db.Date

  calls  Int @default(0)
  tokens Int @default(0)
  /// Coste estimado en milesimas de la moneda, como en `FlowBotMetric`: los
  /// decimales de coma flotante no suman bien dinero.
  costMillis Int @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, day])
  @@index([companyId, day])
  @@map("flowbot_ai_usage")
}
